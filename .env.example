# Copy this file to ".env" (same folder) and fill in the two values from your
# Supabase project: Project Settings -> API (Project URL and the anon public key).
# .env is never committed (see .gitignore). Restart "npm run dev" after editing.
#
# The anon key is a PUBLIC key, made to be used in browsers. Never put the
# Anthropic API key here: it stays on Supabase as the ANTHROPIC_API_KEY secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
